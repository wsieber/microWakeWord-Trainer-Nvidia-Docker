#!/bin/bash
set -euo pipefail

PROGPATH=$(realpath "$0")
PROGDIR=$(dirname "${PROGPATH}")

source "${PROGDIR}/shell.functions"

if [ "${HELP}" == "true" ] ; then
    cat <<EOF >&2
Usage: $0 [ --data-dir=<data_dir> ]

    Builds negative features from your own recordings: any audio file ffmpeg can
    read (wav, flac, mp3, m4a, webm, opus, ...) dropped into
    <data_dir>/custom_negatives/. Use it for audio that false-wakes your devices,
    such as a TV show or a YouTube channel. Each file is converted once; a file
    that changes is rebuilt, and features for a removed file are deleted.

    <data_dir>            : Path to the data directory.
                          :    Default: ${DATA_DIR}

EOF
    exit 1
fi

PYTHON="${DATA_DIR}/.venv/bin/python"
MWW_DIR="${DATA_DIR}/tools/microWakeWord"
SRC_DIR="${DATA_DIR}/custom_negatives"
BASE_DIR="${DATA_DIR}/training_datasets/negative_datasets/custom"
OUT_DIR="${BASE_DIR}/training"
DONE_DIR="${BASE_DIR}/.done"

mkdir -p "${SRC_DIR}" "${OUT_DIR}" "${DONE_DIR}"

# Serialize concurrent runs, as setup_voxpopuli does.
exec 9> "${BASE_DIR}/.lock"
if ! flock -n 9 ; then
    echo "   Another custom-negatives setup is running; waiting for it to finish"
    flock 9
fi

echo "===== Checking custom negatives in ${SRC_DIR} ====="

shopt -s nullglob
declare -A keep=()
for src in "${SRC_DIR}"/* ; do
    [ -f "${src}" ] || continue
    name=$(basename "${src}")
    case "${name}" in
        .*|*.part|*.ytdl|*.json|*.txt|*.md) continue ;;
    esac
    # Safe, stable dataset name from the file name (extension dropped).
    key=$(printf '%s' "${name%.*}" | tr -c 'A-Za-z0-9._-' '_')
    keep["${key}"]=1
    mmap_dir="${OUT_DIR}/${key}_mmap"
    signature="$(stat -c '%s %Y' "${src}")"

    if [ -d "${mmap_dir}" ] && [ "$(cat "${DONE_DIR}/${key}" 2>/dev/null)" = "${signature}" ] ; then
        continue
    fi

    echo "   ${name}: converting to 16 kHz mono"
    wav="${BASE_DIR}/${key}.tmp.wav"
    ffmpeg -nostdin -hide_banner -loglevel error -y -i "${src}" -vn -ac 1 -ar 16000 -sample_fmt s16 "${wav}"

    echo "   ${name}: generating features"
    rm -rf "${mmap_dir}" "${mmap_dir}.partial"
    PYTHONPATH="${MWW_DIR}${PYTHONPATH:+:${PYTHONPATH}}" "${PYTHON}" "${PROGDIR}/custom_negative_features.py" \
        --wav="${wav}" --out-dir="${mmap_dir}.partial"
    mv "${mmap_dir}.partial" "${mmap_dir}"
    printf '%s' "${signature}" > "${DONE_DIR}/${key}"
    rm -f "${wav}"
done

# Drop features whose source file is gone.
for mmap_dir in "${OUT_DIR}"/*_mmap ; do
    key=$(basename "${mmap_dir}" _mmap)
    if [ -z "${keep[${key}]:-}" ] ; then
        echo "   ${key}: source removed, deleting its features"
        rm -rf "${mmap_dir}" "${DONE_DIR}/${key}"
    fi
done

count=0
for mmap_dir in "${OUT_DIR}"/*_mmap ; do count=$((count + 1)) ; done
if [ "${count}" -gt 0 ] ; then
    echo "   Custom negatives ready: ${count} file(s), $(du -sh "${OUT_DIR}" | cut -f1)"
else
    echo "   No custom negatives (drop audio files into ${SRC_DIR} to add some)"
fi
